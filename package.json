{
  "name": "qtvq",
  "version": "1.0.0",
  "description": "我心永恒-Q问 情感避坑与AI智慧问答",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx wrangler pages dev . --port 8788",
    "serve": "python -m http.server 8080",
    "deploy": "powershell -ExecutionPolicy Bypass -File tools/scripts/deploy.ps1 -SkipKv",
    "deploy:all": "powershell -ExecutionPolicy Bypass -File tools/scripts/deploy-all.ps1",
    "deploy:api-only": "powershell -ExecutionPolicy Bypass -File tools/scripts/deploy-all.ps1 -SkipStatic",
    "sync:static": "powershell -ExecutionPolicy Bypass -File tools/scripts/sync-static-from-windows.ps1",
    "deploy:api:linux": "bash tools/scripts/deploy-api.sh",
    "deploy:server": "powershell -ExecutionPolicy Bypass -File tools/scripts/deploy-server-ssh.ps1",
    "deploy:api-only:linux": "bash tools/scripts/deploy-api.sh",
    "deploy:site": "powershell -ExecutionPolicy Bypass -File tools/scripts/build-pages-public.ps1 && npx wrangler pages deploy dist/pages-public --project-name=qtvq-site --commit-dirty=true",
    "setup:kv": "powershell -ExecutionPolicy Bypass -File tools/scripts/setup-kv.ps1",
    "deploy:full": "powershell -ExecutionPolicy Bypass -File tools/scripts/deploy.ps1",
    "post-deploy": "powershell -ExecutionPolicy Bypass -File tools/scripts/post-deploy.ps1",
    "dashboard": "powershell -ExecutionPolicy Bypass -File tools/scripts/open-dashboard.ps1",
    "bind:domain": "powershell -ExecutionPolicy Bypass -File tools/scripts/bind-custom-domain.ps1",
    "github:publish": "powershell -ExecutionPolicy Bypass -File tools/scripts/publish-github.ps1",
    "context:build": "powershell -ExecutionPolicy Bypass -File tools/scripts/build-context-bundle.ps1",
    "context:upload": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-obs.ps1",
    "sync:obs": "powershell -ExecutionPolicy Bypass -File tools/scripts/sync-obs.ps1",
    "backup:publish": "python tools/scripts/publish-backup-snapshots.py",
    "sync:obsidian": "powershell -ExecutionPolicy Bypass -File tools/scripts/sync-obsidian.ps1",
    "git:push-all": "powershell -ExecutionPolicy Bypass -File tools/scripts/push-all.ps1",
    "check:live": "powershell -ExecutionPolicy Bypass -File tools/scripts/check-live.ps1",
    "mail:secrets": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-mail-secrets.ps1",
    "wechat:secrets": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-wechat-secrets.ps1",
    "wechat:secrets:linux": "bash tools/scripts/upload-wechat-secrets.sh",
    "wechat:test-sign": "node tools/scripts/test-wechat-sign.mjs",
    "speech:secrets": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-speech-secrets.ps1",
    "llm:secrets": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-llm-secrets.ps1",
    "check:llm": "node tools/scripts/check-llm.mjs",
    "llm:models": "node tools/scripts/check-llm-models.mjs",
    "build:rag": "node tools/scripts/build-rag-index.js",
    "logo:export": "node tools/scripts/export-logo-png.js",
    "release:manifest": "node tools/scripts/write-release-manifest.mjs",
    "release:download-config": "node tools/scripts/write-download-config.mjs",
    "release:prepare": "node tools/scripts/write-app-releases.mjs && node tools/scripts/write-release-manifest.mjs && node tools/scripts/write-download-config.mjs",
    "desktop:web": "node tools/scripts/sync-desktop-web.mjs",
    "desktop:stage": "node tools/scripts/publish-desktop-release.mjs",
    "desktop:upload": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-desktop-ssh.ps1",
    "check:platforms": "node apps/qtvq-uni/scripts/check-platforms.js",
    "check:download-page": "node tools/scripts/check-download-page.mjs",
    "check:all": "node tools/scripts/check-all.mjs",
    "check:local": "node tools/scripts/check-all.mjs --local",
    "package:static": "powershell -ExecutionPolicy Bypass -File tools/scripts/package-static.ps1",
    "upload:static-obs": "powershell -ExecutionPolicy Bypass -File tools/scripts/upload-static-obs.ps1",
    "uni:install": "cd apps/qtvq-uni && npm install",
    "uni:dev:h5": "cd apps/qtvq-uni && npm run dev:h5",
    "uni:dev:mp-weixin": "cd apps/qtvq-uni && npm run dev:mp-weixin",
    "uni:dev:mp-alipay": "cd apps/qtvq-uni && npm run dev:mp-alipay",
    "uni:dev:mp-toutiao": "cd apps/qtvq-uni && npm run dev:mp-toutiao",
    "uni:dev:mp-xhs": "cd apps/qtvq-uni && npm run dev:mp-xhs",
    "build:mp-weixin": "cd apps/qtvq-uni && npm run build:mp-weixin",
    "build:mp-alipay": "cd apps/qtvq-uni && npm run build:mp-alipay",
    "build:mp-toutiao": "cd apps/qtvq-uni && npm run build:mp-toutiao",
    "build:mp-xhs": "cd apps/qtvq-uni && npm run build:mp-xhs",
    "build:mp-all": "cd apps/qtvq-uni && npm run build:mp-all",
    "uni:build:weixin": "npm run build:mp-weixin",
    "uni:build:alipay": "npm run build:mp-alipay",
    "uni:sync-static": "node tools/scripts/sync-uni-static.js",
    "kv:create": "npx wrangler kv namespace create QTVQ_KV && npx wrangler kv namespace create QTVQ_KV --preview",
    "preview": "npx wrangler pages dev . --port 8788 --local-protocol=http",
    "release:app-releases": "node tools/scripts/write-app-releases.mjs",
    "check:app-bootstrap": "node tools/scripts/check-app-bootstrap.mjs",
    "check:functions": "node tools/scripts/check-functions-bundle.mjs",
    "check:uniappx": "node tools/scripts/check-uniappx.mjs",
    "harmony:compile": "powershell -ExecutionPolicy Bypass -File tools/scripts/compile-harmony.ps1 -CompileOnly",
    "harmony:run": "powershell -ExecutionPolicy Bypass -File tools/scripts/compile-harmony.ps1",
    "diag:green": "cd server && npm run diag:green",
    "check:content-safety": "node tools/scripts/check-content-safety.mjs",
    "check:review": "node tools/scripts/check-review-compliance.mjs",
    "check:review-mutation": "node tools/scripts/test-review-compliance-mutation.mjs",
    "mp:upload": "node tools/scripts/upload-mp-weixin.mjs",
    "check:data-export": "node tools/scripts/check-data-export.mjs",
    "check:data-export-mutation": "node tools/scripts/test-data-export-mutation.mjs",
    "check:app-releases": "node tools/scripts/check-app-releases-coverage.mjs",
    "check:mini-colors": "node tools/scripts/check-mini-colors.mjs",
    "check:channel": "node tools/scripts/check-channel-contract.mjs",
    "check:desktop-release": "node tools/scripts/check-desktop-release.mjs",
    "build:h5": "cd apps/qtvq-uni && npm run build:h5",
    "uni:build:h5": "npm run build:h5",
    "check:desktop-shell": "node tools/scripts/check-desktop-shell.mjs",
    "check:mp-materials": "node tools/scripts/check-mp-materials.mjs",
    "mp:qrcode": "node tools/scripts/apply-mp-qrcode.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "wrangler": "^4.96.0"
  }
}
