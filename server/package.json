{
  "name": "qtvq-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QTVQ 路线B（AI 配对报告）· Node + Express + MongoDB 自建服务",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "import:pitfalls": "node scripts/import-pitfalls.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "probe:models": "node scripts/probe-models.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:wheel": "node scripts/e2e-wheel.mjs",
    "test:frontend": "node scripts/e2e-frontend.mjs",
    "test:billing": "node scripts/e2e-billing-safety.mjs",
    "test:all": "npm run check:imports && npm run test:e2e && npm run test:billing && npm run test:wheel && npm run test:frontend",
    "check:ps1": "node ../tools/scripts/check-ps1-bom.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0"
  }
}
