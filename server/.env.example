# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== MongoDB =====
# 本地 docker-compose: mongodb://127.0.0.1:27017/qtvq
# 自建副本集 / 阿里云 MongoDB: mongodb://user:pass@host:27017/qtvq?replicaSet=rs0&authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017/qtvq
MONGO_DB=qtvq

# ===== 身份桥接（关键：不迁移现有账号）=====
# 新服务通过调用现有 Cloudflare 站点的 /api/auth/me 把旧会话换成 uid
LEGACY_API_BASE=https://qtvq-api.pages.dev
# 本服务自签 JWT（用于后续独立注册；与旧体系共存）
JWT_SECRET=
JWT_TTL=30d

# ===== 模型（默认阿里云百炼，境内可用，与现有阿里云 NLS/OSS 同供应商）=====
# EMBED_PROVIDER / LLM_PROVIDER: dashscope | workers-ai | openai
EMBED_PROVIDER=dashscope
LLM_PROVIDER=dashscope

DASHSCOPE_API_KEY=
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
# 模型降级链：逗号分隔。百炼在「仅使用免费额度」模式下配额用尽会返回
# 403 AllocationQuota.FreeTierOnly，配一个候选模型可避免整份报告退化成兜底文案
CHAT_MODEL=qwen-plus,qwen-turbo,qwen-flash
# 必须是 1024：与现网 Cloudflare qwen3-embedding-0.6b 维度一致，便于日后互换
EMBED_DIMS=1024

# 复用现有 Cloudflare Workers AI（可选）
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_EMBED_MODEL=@cf/qwen/qwen3-embedding-0.6b
CF_CHAT_MODEL=@cf/zai-org/glm-4.7-flash

# OpenAI（最后备选；大陆服务器不可直连，且涉及个人信息出境，默认不要启用）
OPENAI_KEY=
OPENAI_BASE=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ===== CORS =====
CORS_ORIGINS=https://qtvq.cn,https://www.qtvq.cn,http://localhost:8080,http://localhost:8788

# ===== 计费 =====
# 0 = 只计算不扣款（响应里仍会明确标注 reason/label），用于灰度；1 = 真扣
ENFORCE_BILLING=1
# 新钱包初始赠送余额（元）；0 = 关闭
WELCOME_BALANCE=10
# 免费档位（逗号分隔）。默认 basic（缘分一转 ¥1）免费，作为体验档
FREE_TIERS=basic
# 会员（现网月/季/年卡）每日可免费生成的次数，任意档位
MEMBER_DAILY_FREE=1
# 不同举报人数达到该阈值时，目标用户自动转 invisible（等人工确认，不直接封禁）
MODERATION_AUTO_HIDE=5

# ===== 运营台（/v1/admin/*）=====
# 不配置则整组接口返回 404（不暴露后台存在）。只接受 X-Admin-Key 请求头，不支持 URL 传参
ADMIN_KEY=

# ===== 内容安全 =====
# local = 仅本地词表；local+wechat = 额外调用微信 msg_sec_check（需下面两个密钥）
# 本地词表始终生效，外部服务异常时不阻塞业务（只记日志并按本地结果放行）
SAFETY_PROVIDER=local
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# ===== 开发开关 =====
# 1 = 允许 /v1/auth/dev-login 直接签发 token（仅本地/内测，生产必须为 0）
ALLOW_DEV_LOGIN=0
