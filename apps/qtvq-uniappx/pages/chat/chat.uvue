<template>
  <view class="page">
    <view class="card">
      <text class="card-title">问一问</text>
      <text class="hint">把困惑写清楚（越具体越好）：例如"他说先做朋友，是什么意思？"</text>
      <textarea v-model="message" class="input-area" placeholder="在这里描述你的问题…" :maxlength="2000" />

      <view class="row">
        <!-- 语音输入：能力由服务端下发（capabilities.voiceInput = 阿里云 NLS 是否就绪）。
             没就绪时按钮**不出现**，而不是摆一个点了必然失败的按钮。 -->
        <button v-if="voiceEnabled" class="btn-secondary voice-btn" @click="toggleVoice">
          {{ recording ? '⏹ 停止录音' : '🎤 语音输入' }}
        </button>
        <button class="btn-primary ask-btn" :disabled="sending" @click="submit">{{ sending ? '思考中…' : '提问' }}</button>
      </view>
      <text v-if="statusText.length > 0" class="hint">{{ statusText }}</text>
    </view>

    <view class="card" v-if="answer.length > 0">
      <text class="card-title">回答</text>
      <text class="answer">{{ answer }}</text>
      <text class="hint">本次获得 Q币 {{ qCoins }} · 智慧 {{ wisdom }}</text>
      <view class="row">
        <button class="btn-secondary half" @click="askMore">再问一步</button>
        <button class="btn-secondary half" @click="share">分享这段回答</button>
      </view>
    </view>

    <view class="card">
      <text class="card-title">本次回答的来源</text>
      <text class="hint">模型：{{ modelInfo }}（由服务端降级链决定，端侧不写死模型名）</text>
      <text class="hint" v-if="fallback">注意：这条是兜底话术（服务端模型链全部失败），仅供参考</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from 'vue'
  import { askAI, API_BASE } from '@/utils/api.uts'
  import { clientId } from '@/utils/session.uts'
  import { fetchCapabilities } from '@/utils/update.uts'

  const message = ref<string>('')
  const answer = ref<string>('')
  const statusText = ref<string>('')
  const sending = ref<boolean>(false)
  const qCoins = ref<number>(0)
  const wisdom = ref<number>(0)
  const fallback = ref<boolean>(false)
  const modelInfo = ref<string>('未知')

  // 语音
  const voiceEnabled = ref<boolean>(false)
  const recording = ref<boolean>(false)
  let recorder : RecorderManager | null = null

  onShow(() => {
    // 能力清单决定语音按钮是否出现（服务端 NLS 没配好就不显示）
    fetchCapabilities((caps : UTSJSONObject) => {
      const v = caps['voiceInput']
      voiceEnabled.value = v != null ? (v as boolean) : false
    })
  })

  function submit() {
    const text : string = message.value.trim()
    if (text.length == 0) {
      uni.showToast({ title: '请先写下你的问题', icon: 'none' })
      return
    }
    sending.value = true
    statusText.value = '正在思考…'

    askAI(text, clientId(), (data : UTSJSONObject) => {
      sending.value = false
      statusText.value = ''
      const reply = data['reply']
      answer.value = reply != null ? (reply as string) : ''

      const coins = data['qCoins']
      if (coins != null) qCoins.value = coins as number
      const wis = data['wisdom']
      if (wis != null) wisdom.value = wis as number
      const fb = data['fallback']
      fallback.value = fb != null ? (fb as boolean) : false

      // 服务端会告诉我们这一条由哪个模型答的，排查时不必开控制台
      const ai = data['ai']
      if (ai != null) {
        const a : UTSJSONObject = ai as UTSJSONObject
        const provider = a['provider']
        const model = a['model']
        const p : string = provider != null ? (provider as string) : '未知'
        const m : string = model != null ? (model as string) : '未知'
        modelInfo.value = `${p}:${m}`
      }
    }, (msg : string) => {
      sending.value = false
      statusText.value = msg
      uni.showToast({ title: msg, icon: 'none' })
    })
  }

  function askMore() {
    message.value = '请给更具体的行动措辞（可以直接照着说的那种）'
    submit()
  }

  /**
   * 语音输入：录音 → 读文件转 base64 → POST /api/speech。
   *
   * 服务端契约（`functions/api/speech.js`）：JSON `{audio: base64, format, sampleRate}`，上限 512KB。
   * 所以录音用 16k 单声道、短句更稳。失败一律给出可读原因，不静默失败。
   */
  function toggleVoice() {
    if (recording.value) {
      if (recorder != null) recorder!.stop()
      return
    }
    try {
      if (recorder == null) {
        recorder = uni.getRecorderManager()
        recorder!.onStop((res : RecorderManagerOnStopResult) => {
          recording.value = false
          const path : string = res.tempFilePath
          if (path.length == 0) {
            statusText.value = '录音失败：没有拿到文件'
            return
          }
          statusText.value = '识别中…'
          uni.getFileSystemManager().readFile({
            filePath: path,
            success: (r : ReadFileSuccessResult) => {
              const base64 : string = uni.arrayBufferToBase64(r.data as ArrayBuffer)
              uploadSpeech(base64, res.format != null && res.format.length > 0 ? res.format : 'mp3')
            },
            fail: (_) => {
              statusText.value = '读取录音文件失败'
            },
          })
        })
        recorder!.onError((err : RecorderManagerErrorCallbackResult) => {
          recording.value = false
          statusText.value = '录音出错：' + err.errMsg
        })
      }
      recorder!.start({
        duration: 60000,
        sampleRate: 16000,
        numberOfChannels: 1,
        format: 'mp3',
      } as RecorderManagerStartOptions)
      recording.value = true
      statusText.value = '正在录音…说完点「停止录音」'
    } catch (e) {
      recording.value = false
      statusText.value = '当前设备不支持录音'
    }
  }

  function uploadSpeech(base64 : string, format : string) {
    uni.request({
      url: `${API_BASE}/api/speech`,
      method: 'POST',
      header: { 'Content-Type': 'application/json' },
      data: { audio: base64, format: format, sampleRate: 16000 } as UTSJSONObject,
      dataType: 'json',
      timeout: 30000,
      success: (res) => {
        const raw = res.data
        if (raw == null) {
          statusText.value = '识别失败：服务端返回为空'
          return
        }
        const data : UTSJSONObject = raw as UTSJSONObject
        if (res.statusCode < 200 || res.statusCode >= 300) {
          const err = data['error']
          statusText.value = err != null ? (err as string) : `识别失败 HTTP ${res.statusCode}`
          return
        }
        const text = data['text']
        if (text != null && (text as string).length > 0) {
          message.value = text as string
          statusText.value = '已识别，可直接提问'
        } else {
          statusText.value = '没有识别到内容，请靠近麦克风再说一次'
        }
      },
      fail: (err) => {
        statusText.value = '识别请求失败：' + err.errMsg
      },
    })
  }

  /** 系统分享：鸿蒙侧不需要第三方凭据，直接调系统分享面板 */
  function share() {
    const text : string = answer.value
    if (text.length == 0) return
    uni.shareWithSystem({
      summary: text.substring(0, 80),
      success: () => {},
      fail: (err) => {
        uni.showToast({ title: '分享未完成：' + err.errMsg, icon: 'none' })
      },
    })
  }
</script>

<style>
  .page { padding: 12px; background-color: #0f0e17; }
  .input-area {
    width: 100%;
    height: 120px;
    background-color: #0f0e17;
    color: #f5f5f7;
    border-width: 1px;
    border-style: solid;
    border-color: #2a2940;
    border-radius: 8px;
    padding: 8px;
    margin: 8px 0;
    font-size: 14px;
  }
  .answer { font-size: 14px; color: #f5f5f7; line-height: 1.7; }
  .row { flex-direction: row; justify-content: space-between; margin-top: 6px; }
  .voice-btn { flex: 1; margin-right: 8px; }
  .ask-btn { flex: 1; }
  .half { flex: 1; margin-right: 8px; }
</style>
