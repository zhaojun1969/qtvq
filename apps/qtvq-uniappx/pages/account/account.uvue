<template>
  <view class="page">
    <view class="card" v-if="!loggedIn">
      <text class="card-title">登录 / 注册</text>
      <text class="hint">手机号 + 密码。注册即视为同意《隐私政策》；同一账号在各端通用。</text>

      <!-- 微信一键登录：走「微信开放平台 → 移动应用」授权（uni.login → 服务端换 code → 会话）。
           能力由服务端下发：没配开放平台凭据时按钮不出现，不摆一个点了必然失败的按钮。 -->
      <button v-if="wechatLoginEnabled" class="btn-wechat" @click="loginByWechat">微信一键登录（推荐）</button>

      <input v-model="phone" class="input" type="number" :maxlength="11" placeholder="11 位手机号" />
      <input v-model="password" class="input" password placeholder="密码至少 6 位" />
      <button class="btn-primary" @click="login">登录</button>
      <button class="btn-secondary" @click="register">注册新账号</button>
      <text v-if="msg.length > 0" class="hint">{{ msg }}</text>
    </view>

    <view class="card" v-else>
      <text class="card-title">账户</text>
      <text class="hint">{{ userLabelText }}</text>
      <text class="hint">设备编号 {{ clientIdShort }}</text>
      <button class="btn-secondary" @click="logout">退出登录</button>
    </view>

    <view class="card">
      <text class="card-title">会员</text>
      <text class="hint">月卡 ¥29 · 季卡 ¥79 · 年卡 ¥299。汇款核实后开通不限次提问。</text>
      <text class="hint">在鸿蒙端办理：请到网页版 qtvq.cn 的「办理会员」页扫码付款，或联系客服。</text>
      <button class="btn-secondary" @click="openWeb">打开网页版办理</button>
    </view>

    <view class="card">
      <text class="card-title">遇到问题</text>
      <text class="hint">客户端版本：{{ version }}</text>
      <text class="hint">客服邮箱：qtvq@qtvq.cn</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref } from 'vue'
  import { API_BASE } from '@/utils/api.uts'
  import { clientId, setSession, clearSession, isLoggedIn, userLabel } from '@/utils/session.uts'
  import { appVersion, fetchCapabilities } from '@/utils/update.uts'

  const loggedIn = ref<boolean>(isLoggedIn())
  const phone = ref<string>('')
  const password = ref<string>('')
  const msg = ref<string>('')
  const userLabelText = ref<string>(userLabel())
  const clientIdShort = ref<string>('')
  const version = ref<string>(appVersion())
  /** 微信一键登录是否可用：由服务端能力清单下发（开放平台移动应用凭据是否配好） */
  const wechatLoginEnabled = ref<boolean>(false)

  onShow(() => {
    // 能力清单决定按钮显隐：没配好就不显示，不摆一个点了必然失败的按钮
    fetchCapabilities((caps : UTSJSONObject) => {
      const login = caps['login']
      if (login != null) {
        const l : UTSJSONObject = login as UTSJSONObject
        const v = l['harmony']
        wechatLoginEnabled.value = v != null ? (v as boolean) : false
      }
    })
    loggedIn.value = isLoggedIn()
    userLabelText.value = userLabel()
    const id : string = clientId()
    clientIdShort.value = id.length > 16 ? `${id.substring(0, 16)}…` : id
  })

  function submit(action : string) {
    if (phone.value.length != 11) {
      uni.showToast({ title: '请输入 11 位手机号', icon: 'none' })
      return
    }
    if (password.value.length < 6) {
      uni.showToast({ title: '密码至少 6 位', icon: 'none' })
      return
    }
    msg.value = '处理中…'
    const body : UTSJSONObject = {
      action: action,
      phone: phone.value,
      password: password.value,
      clientId: clientId(),
    }
    uni.request({
      url: `${API_BASE}/api/auth`,
      method: 'POST',
      header: { 'Content-Type': 'application/json' },
      data: body,
      dataType: 'json',
      timeout: 15000,
      success: (res) => {
        const raw = res.data
        if (raw == null) {
          msg.value = '服务端返回为空'
          return
        }
        const data : UTSJSONObject = raw as UTSJSONObject
        if (res.statusCode < 200 || res.statusCode >= 300) {
          const err = data['error']
          msg.value = err != null ? (err as string) : `HTTP ${res.statusCode}`
          return
        }
        const tk = data['token']
        const u = data['user']
        if (tk == null || u == null) {
          msg.value = '登录信息不完整'
          return
        }
        setSession(tk as string, u as UTSJSONObject)
        loggedIn.value = true
        userLabelText.value = userLabel()
        msg.value = action == 'login' ? '登录成功' : '注册成功'
        uni.showToast({ title: msg.value, icon: 'success' })
      },
      fail: (err) => {
        msg.value = '网络失败：' + err.errMsg
      },
    })
  }

  function login() {
    submit('login')
  }

  function register() {
    submit('register')
  }

  /**
   * 微信一键登录（App 端走「微信开放平台 → 移动应用」授权）。
   *
   * 流程：`uni.login` 拿 code → 交给服务端 `/api/auth/wechat/open` 换 openid 并建立会话。
   * 服务端未配置开放平台凭据时会返回明确错误，这里**原样展示**（不静默失败，
   * 否则用户只看到"点了没反应"）。
   */
  function loginByWechat() {
    msg.value = '正在唤起微信…'
    uni.login({
      provider: 'weixin',
      success: (res : LoginSuccess) => {
        const code : string = res.code
        if (code.length == 0) {
          msg.value = '未取到微信授权码'
          return
        }
        // 服务端契约：action='resetPassword' 走重置，其它（含不传）一律走登录 —— 所以这里不传 action
        const body : UTSJSONObject = { code: code, clientId: clientId() }
        uni.request({
          url: `${API_BASE}/api/auth/wechat/open`,
          method: 'POST',
          header: { 'Content-Type': 'application/json' },
          data: body,
          dataType: 'json',
          timeout: 15000,
          success: (r) => {
            const raw = r.data
            if (raw == null) {
              msg.value = '服务端返回为空'
              return
            }
            const data : UTSJSONObject = raw as UTSJSONObject
            if (r.statusCode < 200 || r.statusCode >= 300) {
              const err = data['error']
              msg.value = err != null ? (err as string) : `微信登录失败 HTTP ${r.statusCode}`
              return
            }
            const tk = data['token']
            const u = data['user']
            if (tk == null || u == null) {
              msg.value = '微信登录返回信息不完整'
              return
            }
            setSession(tk as string, u as UTSJSONObject)
            loggedIn.value = true
            userLabelText.value = userLabel()
            msg.value = '微信登录成功'
            uni.showToast({ title: '登录成功', icon: 'success' })
          },
          fail: (err) => {
            msg.value = '微信登录请求失败：' + err.errMsg
          },
        })
      },
      fail: (err) => {
        msg.value = '未完成微信授权：' + err.errMsg
      },
    } as LoginOptions)
  }

  function logout() {
    clearSession()
    loggedIn.value = false
    userLabelText.value = '未登录'
    uni.showToast({ title: '已退出', icon: 'none' })
  }

  function openWeb() {
    uni.openURL({ url: 'https://qtvq.cn/account.html' })
  }
</script>

<style>
  .page { padding: 12px; background-color: #0f0e17; }
  .btn-wechat {
    background-color: #07c160;
    color: #ffffff;
    border-radius: 999px;
    font-size: 15px;
    margin-bottom: 8px;
  }
  .input {
    height: 42px;
    background-color: #0f0e17;
    color: #f5f5f7;
    border-width: 1px;
    border-style: solid;
    border-color: #2a2940;
    border-radius: 8px;
    padding: 0 8px;
    margin: 6px 0;
    font-size: 15px;
  }
</style>
