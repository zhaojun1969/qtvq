{
  "name": "qtvq-desktop",
  "version": "1.0.7",
  "description": "我心永恒 Q问 · Windows 桌面客户端",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check preload/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win nsis portable --publish never",
    "smoke": "electron scripts/smoke.js"
  },
  "build": {
    "appId": "cn.qtvq.desktop",
    "productName": "Q问",
    "copyright": "我心永恒（北京）网络科技有限公司",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "preload/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Q问",
      "artifactName": "qtvq-desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "qtvq-desktop-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://qtvq.cn/release/desktop/",
        "channel": "latest"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
